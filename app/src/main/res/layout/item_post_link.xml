<?xml version="1.0" encoding="utf-8"?>
<!-- Card layout for link posts: title and flairs, thumbnail on the end -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/post_padding_horizontal"
    android:paddingTop="@dimen/post_padding_top"
    android:paddingBottom="@dimen/post_padding_bottom"
    android:background="?attr/selectableItemBackground">

    <include
        android:id="@id/include_post_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_post_info"/>

    <TextView
        android:id="@+id/text_post_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearancePostTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/image_post_link_preview"
        app:layout_constraintTop_toBottomOf="@id/include_post_info"
        android:layout_marginTop="@dimen/post_spacing"
        android:layout_marginEnd="@dimen/post_compact_thumbnail_margin"
        android:maxLines="@integer/post_title_max_lines"
        android:ellipsize="end"
        tools:text="Title" />

    <include
        android:id="@+id/include_post_flairs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/text_post_title"
        app:layout_constraintTop_toBottomOf="@id/text_post_title"
        android:layout_marginTop="@dimen/post_spacing"
        layout="@layout/include_post_flairs"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_post_link_preview"
        android:layout_width="@dimen/post_link_image_size"
        android:layout_height="@dimen/post_link_image_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/text_post_title"
        android:layout_marginTop="@dimen/post_spacing_small"
        android:scaleType="centerCrop"
        android:background="@color/post_media_background_color"
        app:shapeAppearanceOverlay="@style/PostMediaShape"
        app:strokeWidth="@dimen/post_media_stroke"
        app:strokeColor="@color/post_media_stroke_color"
        android:contentDescription="Link preview image"
        tools:src="@tools:sample/backgrounds/scenic" />

    <ImageView
        android:id="@+id/image_link_indicator"
        android:layout_width="@dimen/post_compact_indicator_size"
        android:layout_height="@dimen/post_compact_indicator_size"
        app:layout_constraintEnd_toEndOf="@id/image_post_link_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_post_link_preview"
        android:layout_margin="@dimen/post_spacing_small"
        android:padding="@dimen/post_compact_indicator_padding"
        android:background="@drawable/post_type_indicator_background"
        android:contentDescription="@null"
        app:tint="@color/white"
        app:srcCompat="@drawable/ic_link"/>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="image_post_link_preview, include_post_flairs, text_post_title" />

    <com.cosmos.unreddit.ui.common.widget.AwardView
        android:id="@+id/awards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/barrier_bottom"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/post_spacing"
        android:paddingVertical="@dimen/award_chip_padding_vertical_post"
        android:paddingHorizontal="@dimen/award_chip_padding_horizontal_post"
        app:textStyle="@style/TextAppearanceAwardPost"/>

    <include
        android:id="@+id/include_post_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/awards"
        android:layout_marginTop="@dimen/post_spacing_small"
        layout="@layout/include_post_metrics"/>

</androidx.constraintlayout.widget.ConstraintLayout>
