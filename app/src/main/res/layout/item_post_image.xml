<?xml version="1.0" encoding="utf-8"?>
<!-- Card layout for image, gallery and video posts -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/post_padding_horizontal"
    android:paddingTop="@dimen/post_padding_top"
    android:paddingBottom="@dimen/post_padding_bottom"
    android:background="?attr/selectableItemBackground">

    <include
        android:id="@id/include_post_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_post_info"/>

    <TextView
        android:id="@+id/text_post_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearancePostTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include_post_info"
        android:layout_marginTop="@dimen/post_spacing"
        android:maxLines="@integer/post_title_max_lines"
        android:ellipsize="end"
        tools:text="This is a post" />

    <include
        android:id="@+id/include_post_flairs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_post_title"
        android:layout_marginTop="@dimen/post_spacing"
        layout="@layout/include_post_flairs"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_post_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include_post_flairs"
        app:layout_constraintDimensionRatio="H,4:3"
        app:layout_constraintHeight_max="@dimen/post_media_max_height"
        android:layout_marginTop="@dimen/post_spacing"
        android:scaleType="centerCrop"
        android:background="@color/post_media_background_color"
        app:shapeAppearanceOverlay="@style/PostMediaShape"
        app:strokeWidth="@dimen/post_media_stroke"
        app:strokeColor="@color/post_media_stroke_color"
        android:contentDescription="Post preview image"
        tools:src="@tools:sample/backgrounds/scenic"/>

    <ImageView
        android:id="@+id/button_type_indicator"
        android:layout_width="@dimen/post_type_indicator_size"
        android:layout_height="@dimen/post_type_indicator_size"
        app:layout_constraintEnd_toEndOf="@id/image_post_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_post_preview"
        android:layout_margin="@dimen/post_type_indicator_margin"
        android:padding="@dimen/post_type_indicator_padding"
        android:background="@drawable/post_type_indicator_background"
        android:contentDescription="@null"
        app:tint="@color/white"
        tools:src="@drawable/ic_play"/>

    <com.cosmos.unreddit.ui.common.widget.AwardView
        android:id="@+id/awards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/image_post_preview"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/post_spacing"
        android:paddingVertical="@dimen/award_chip_padding_vertical_post"
        android:paddingHorizontal="@dimen/award_chip_padding_horizontal_post"
        app:textStyle="@style/TextAppearanceAwardPost"/>

    <include
        android:id="@+id/include_post_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/awards"
        android:layout_marginTop="@dimen/post_spacing_small"
        layout="@layout/include_post_metrics"/>

</androidx.constraintlayout.widget.ConstraintLayout>
